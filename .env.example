# .env 文件内容示例：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会入库）
# 格式：KEY=value，一行一个，# 开头为注释；也兼容 export KEY=value

# ===== 必填：飞书自建应用与多维表格 =====
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_APP_TOKEN=bascnXXX
# 表格 URL 里 table= 后面的值；变量不要留空，空值会被当作"已配置"而不再回退默认值
FEISHU_TABLE_ID=tblXXX

# ===== 跑 mcp_pipe.py 时必填：小智 MCP 接入点 =====
# 小智控制台「智能体 → 配置角色」右下角复制；未设置时 mcp_pipe.py 以退出码 1 结束
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=xxx

# ===== 可选：字段名映射（默认值与下方一致，列名不同才需取消注释修改）=====
# 列名必须与飞书表格里的列名一字不差
#FIELD_TITLE=任务内容
#FIELD_RAW=原始语音
#FIELD_DUE=截止日期
#FIELD_PRIO=优先级
#FIELD_SOURCE=来源
#FIELD_REQID=请求ID
#DEFAULT_PRIO=普通

# ===== 可选：多服务配置路径（默认读当前目录的 mcp_config.json）=====
#MCP_CONFIG=E:\26urt\MCP_AI\mcp_config.json
